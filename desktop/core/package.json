{
  "name": "@lamarck/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "main": "dist/core.mjs",
  "scripts": {
    "prebuild": "npm --workspace @lamarck/system run build",
    "build": "node ../../scripts/build-core.mjs",
    "build:native": "node src/device-identity/native/build.mjs",
    "build:guard": "node ../../scripts/build-core.mjs",
    "dev": "npm run build && node src/runtime-launcher.mjs",
    "pretest": "npm run build",
    "test": "node test-node/run-all.mjs",
    "pretest:unit": "npm --workspace @lamarck/cli run build && npm --workspace @lamarck/system run build",
    "test:unit": "node test-node/run-vitest.mjs",
    "pretypecheck": "npm --workspace @lamarck/cli run build && npm --workspace @lamarck/system run build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest:guard-engine": "npm run build:guard",
    "test:guard-engine": "node test-node/run-guard-engine.mjs",
    "pretest:guard-service": "npm run build:guard",
    "test:guard-service": "node test-node/run-guard-service.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.56",
    "@ai-sdk/openai": "4.0.69",
    "@ai-sdk/openai-compatible": "3.0.51",
    "@ai-sdk/provider": "4.0.17",
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@lamarck/cli": "0.1.2",
    "@lamarck/system": "0.1.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex": "0.154.0",
    "ai": "7.0.105",
    "ai-sdk-provider-claude-code": "4.3.1",
    "diff": "^5.2.2",
    "isomorphic-git": "^1.41.9",
    "node-pty": "^1.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
