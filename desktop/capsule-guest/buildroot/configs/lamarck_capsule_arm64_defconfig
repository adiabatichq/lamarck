BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="lamarck-capsule"
BR2_TARGET_GENERIC_ISSUE=""
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LAMARCK_PATH)/board/lamarck/arm64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LAMARCK_PATH)/board/lamarck/arm64/post-build.sh"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LAMARCK_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_PACKAGE_NODE24_BIN=y
# Build Capsules run ordinary npm lifecycle scripts.  Buildroot deliberately
# does not install its cross compiler into the target, so post-build.sh adds
# the exact arm64 Buildroot toolchain separately.  These target-native helpers
# provide the remaining node-gyp prerequisites inside build-node24 only.
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PKGCONF=y
BR2_PACKAGE_RUNC=y
BR2_PACKAGE_LIBSECCOMP=y
BR2_PACKAGE_EROFS_UTILS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_LINUX_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.39"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LAMARCK_PATH)/board/lamarck/arm64/kernel.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1536M"
BR2_TARGET_ROOTFS_EXT2_LABEL="LAMARCK_ROOT"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^metadata_csum_seed -E lazy_itable_init=0,lazy_journal_init=0"
# BR2_TARGET_ROOTFS_TAR is not set
