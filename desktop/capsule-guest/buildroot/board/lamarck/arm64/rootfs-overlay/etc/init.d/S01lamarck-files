#!/bin/sh

set -eu

tag=lamarck-files
mountpoint=/mnt/lamarck-files

start() {
	[ -d "$mountpoint" ] && [ ! -L "$mountpoint" ] || {
		echo "Lamarck D1 mountpoint is missing from the read-only Guest image" >&2
		return 1
	}
	mount -t virtiofs -o ro,nosuid,nodev,noexec "$tag" "$mountpoint"
	awk -v target="$mountpoint" \
		'$2 == target && $3 == "virtiofs" && $4 ~ /(^|,)ro(,|$)/ { found = 1 } END { exit(found ? 0 : 1) }' \
		/proc/mounts || {
		echo "Lamarck D1 share is not mounted read-only" >&2
		return 1
	}
}

stop() {
	umount "$mountpoint" 2>/dev/null || true
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 64 ;;
esac
