{
  "name": "@lamarck/cli",
  "version": "0.1.0",
  "description": "The public command-line interface for Lamarck Personal Systems",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adiabatichq/lamarck.git",
    "directory": "desktop/cli"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "lamarck": "dist/lamarck.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
