{
  "schemaVersion": 1,
  "provider": "telegram",
  "api": "Bot API",
  "transport": "cloud",
  "compatibility": {
    "minimumVersion": "10.0",
    "testedAgainstVersion": "10.1",
    "testedAgainstReleaseDate": "2026-06-11",
    "versionPolicy": "Telegram Cloud Bot API is a rolling service; these versions record the minimum required and last reviewed contracts, not a pinned runtime."
  },
  "references": {
