  },
  "methods": [
    "deleteWebhook",
    "getMe",
    "getUpdates"
  ],
  "updateTypes": [
    "message",
    "edited_message",
    "channel_post",
    "edited_channel_post",
    "business_message",
    "edited_business_message",
    "guest_message"
  ]
}
