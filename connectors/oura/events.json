    "oura.heartrate.batch": {
      "description": "A time-bucketed batch of Oura heart-rate samples.",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema",
          "provider",
          "stream",
          "bucketMs",
          "sampleCount",
          "sourceCounts",
          "samples"
        ],
        "properties": {
          "schema": {
            "const": "oura.heartrate.batch.v1",
            "description": "Connector-owned payload contract discriminator."
          },
          "provider": {
            "const": "oura",
            "description": "Upstream service that produced the records."
          },
          "stream": {
            "const": "heartrate",
            "description": "Oura API stream represented by the batch."
          },
          "bucketMs": {
            "type": "integer",
            "description": "Width of the time bucket in milliseconds."
          },
          "sampleCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of heart-rate samples in the batch."
          },
          "sourceCounts": {
            "type": "object",
            "description": "Sample counts grouped by Oura measurement source.",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "samples": {
            "type": "array",
            "description": "Provider-native Oura heart-rate samples.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "oura.ring_battery.low": {
      "description": "The Oura ring battery crossed below the low threshold.",
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema",
          "provider",
          "stream",
          "kind",
          "record"
        ],
        "properties": {
          "schema": {
            "const": "oura.ring_battery.transition.v1",
            "description": "Connector-owned payload contract discriminator."
          },
          "provider": {
            "const": "oura",
            "description": "Upstream service that produced the record."
          },
          "stream": {
            "const": "ring_battery_level",
            "description": "Oura API stream used to detect the transition."
          },
          "kind": {
            "type": "string",
            "enum": [
              "low",
              "critical",
              "recovered"
            ],
            "description": "Battery threshold transition."
          },
          "record": {
            "type": "object",
            "description": "Provider-native Oura battery sample that caused or confirmed the transition.",
            "additionalProperties": true
          }
        }
      }
    },
